# {{ ansible_managed }}
[Unit]
Description=SMART disk health metrics

[Service]
Type=oneshot
# Type=oneshot does not inherit DefaultTimeoutStartSec, and a SMART command to a
# dying disk can block indefinitely — without this the unit parks in activating
# forever: the timer cannot start another run, ExecStopPost never fires, and the
# stale payload keeps being republished as though it were fresh. The read takes
# milliseconds on a healthy disk.
TimeoutStartSec=5min
ExecStart={{ smartmon_script }}
# Runs whether ExecStart succeeded or failed, reading $SERVICE_RESULT to record
# the outcome as a node_exporter metric.
ExecStopPost={{ smartmon_metric_script }}
