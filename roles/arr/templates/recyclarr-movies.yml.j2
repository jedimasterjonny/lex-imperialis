# TRaSH templates hd-bluray-web + uhd-bluray-web, merged into one instance.
# Re-derive: recyclarr config create -t hd-bluray-web -t uhd-bluray-web, then
# merge into one radarr instance and re-apply the custom_formats overlay below.
radarr:
  movies:
    base_url: http://radarr:7878
    api_key: !secret radarr_api_key
    quality_definition:
      type: movie
    quality_profiles:
      - trash_id: d1d67249d3890e49bc12e275d989a7e9  # HD Bluray + WEB
        reset_unmatched_scores:
          enabled: true
      - trash_id: 64fb5f9858489bdac2af690e27c8f42f  # UHD Bluray + WEB
        reset_unmatched_scores:
          enabled: true
    # A group syncs its required and default formats as soon as it is added, so a
    # `select` is only for opting in to a NON-default one — naming a default there
    # does nothing, and recyclarr reports it after every sync. Every format these
    # three groups used to list was already a default, so the lists are gone; do
    # not re-add the ones a re-scaffold writes.
    custom_format_groups:
      add:
        - trash_id: f8bf8eab4617f12dfdbd16303d8da245  # [Optional] Golden Rule HD
        - trash_id: ff204bbcecdd487d1cefcefdbf0c278d  # [Optional] Golden Rule UHD
        - trash_id: a3ac6af01d78e4f21fcb75f601ac96df  # [Unwanted] Unwanted Formats
    # --- LOCAL DEVIATIONS from TRaSH (re-apply after re-scaffolding) ---
    custom_formats:
      # x265 neutral - operator does not mind x265
      - trash_ids:
          - dc98083864ea246d05a42df0d05f81cc  # x265 (HD)
          - 839bea857ed2c0a8e084f3cbdbd65ecb  # x265 (no HDR/DV)
        assign_scores_to:
          - name: HD Bluray + WEB
            score: 0
          - name: UHD Bluray + WEB
            score: 0
      # block UHD SDR Bluray/Remux, allow SDR WEB
      - trash_ids:
          - 25c12f78430a3a23413652cbd1d48d77  # SDR (no WEBDL)
        assign_scores_to:
          - name: UHD Bluray + WEB

      # DV / HDR10+ boost (rank DV/HDR10+ above plain HDR on UHD)
      - trash_ids:
          - b337d6812e06c200ec9a2d3cfa9d20a7  # DV Boost
        assign_scores_to:
          - name: UHD Bluray + WEB
            score: 1000
      - trash_ids:
          - caa37d0df9c348912df1fb1d88f9273a  # HDR10+ Boost
        assign_scores_to:
          - name: UHD Bluray + WEB
            score: 100
