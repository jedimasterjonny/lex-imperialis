# TRaSH templates web-1080p + web-2160p, merged into one instance.
# Re-derive: recyclarr config create -t web-1080p -t web-2160p, then merge into
# one sonarr instance and re-apply the custom_formats overlay below.
sonarr:
  tv:
    base_url: http://sonarr:8989
    api_key: !secret sonarr_api_key
    quality_definition:
      type: series
    quality_profiles:
      - trash_id: 72dae194fc92bf828f32cde7744e51a1  # WEB-1080p
        reset_unmatched_scores:
          enabled: true
      - trash_id: d1498e7d189fbe6c7110ceaabb7473e6  # WEB-2160p
        reset_unmatched_scores:
          enabled: true
      # From-scratch fallback for shows that only exist in SD/DVD: accepts the DVD
      # rip yet still upgrades to a 1080p WEB rip if one ever surfaces. Assign a
      # series to it by hand; no custom_formats reference it, so the HD profiles
      # stay untouched.
      - name: DVD
        upgrade:
          allowed: true
          until_quality: WEB 1080p
          until_score: 10000
        qualities:
          - name: WEB 1080p
            qualities:
              - WEBDL-1080p
              - WEBRip-1080p
          - name: HDTV-1080p
          - name: WEB 720p
            qualities:
              - WEBDL-720p
              - WEBRip-720p
          - name: HDTV-720p
          - name: DVD
          - name: SDTV
    # A group syncs its required and default formats as soon as it is added, so a
    # `select` is only for opting in to a NON-default one — naming a default there
    # does nothing, and recyclarr reports it after every sync. BR-DISK (BTN) is the
    # only real opt-in here; every other format these lists carried was already a
    # default, so only it remains.
    custom_format_groups:
      add:
        - trash_id: 158188097a58d7687dee647e04af0da3  # [Optional] Golden Rule HD
        - trash_id: e3f37512790f00d0e89e54fe5e790d1c  # [Optional] Golden Rule UHD
        - trash_id: 85fae4a2294965b75710ef2989c850eb  # [Streaming Services] HD/UHD boost
        - trash_id: 59c3af66780d08332fdc64e68297098f  # [Unwanted] Unwanted Formats
          select:
            - 6f808933a71bd9666531610cb8c059cc  # BR-DISK (BTN) - not a group default
    # --- LOCAL DEVIATIONS from TRaSH (re-apply after re-scaffolding) ---
    custom_formats:
      # x265 neutral - operator does not mind x265
      - trash_ids:
          - 47435ece6b99a0b477caf360e79ba0bb  # x265 (HD)
          - 9b64dff695c2115facf1b6ea59c9bd07  # x265 (no HDR/DV)
        assign_scores_to:
          - name: WEB-1080p
            score: 0
          - name: WEB-2160p
            score: 0
      # block UHD SDR
      - trash_ids:
          - 83304f261cf516bb208c18c54c0adf97  # SDR (no WEBDL)
        assign_scores_to:
          - name: WEB-2160p

      # DV / HDR10+ boost (rank DV/HDR10+ above plain HDR on UHD)
      - trash_ids:
          - 7c3a61a9c6cb04f52f1544be6d44a026  # DV Boost
        assign_scores_to:
          - name: WEB-2160p
            score: 1000
      - trash_ids:
          - 0c4b99df9206d2cfac3c05ab897dd62a  # HDR10+ Boost
        assign_scores_to:
          - name: WEB-2160p
            score: 100
