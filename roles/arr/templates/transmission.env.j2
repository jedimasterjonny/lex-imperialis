{#- Both lines exist only when both creds are set: USER/PASS are what turn RPC
    auth on in the LSIO image, so a blank pair would enable auth on an empty
    password, where no lines at all leave the image's auth-off default. -#}
{% if arr_transmission_username and arr_transmission_password %}
USER={{ arr_transmission_username }}
PASS={{ arr_transmission_password }}
{% endif %}
