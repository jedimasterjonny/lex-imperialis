[Unit]
Description=Grafana

[Container]
ContainerName=grafana
Image={{ grafana_image }}
Network=caddy.network
NoNewPrivileges=true
DropCapability=all
{# grafana runs non-root as its own user (472) on an unprivileged port, so it #}
{# needs no capability back. #}
EnvironmentFile=/etc/grafana/env
# :Z relabels both mounts container_file_t on each start: container_t may read
# the host's default /etc label but not watch it, and the dashboard provisioner
# watches its directory.
Volume=/etc/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Volume=/etc/grafana/dashboards:/etc/grafana/dashboards:ro,Z
# :U hands the named volume to the image's grafana user (472), which owns its
# state dir; rootful podman would otherwise create it root-owned.
Volume=grafana-data:/var/lib/grafana:U
# Restart backstop against Grafana's health endpoint (reports DB status), not the
# monitor — see the health convention in roles/CLAUDE.md.
HealthCmd=curl -fsS http://localhost:3000/api/health
HealthInterval=5m
HealthTimeout=30s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
