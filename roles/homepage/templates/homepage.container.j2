[Unit]
Description=Homepage

[Container]
ContainerName=homepage
Image={{ homepage_image }}
Network=caddy.network
NoNewPrivileges=true
DropCapability=all
{# The root entrypoint chowns the config volume to PUID (CHOWN), then drops to #}
{# it with su-exec (SETUID, SETGID); homepage binds :3000, so no #}
{# NET_BIND_SERVICE. #}
AddCapability=CHOWN SETGID SETUID
Environment=PUID={{ homepage_uid }}
Environment=PGID={{ homepage_uid }}
Environment=TZ={{ homepage_timezone }}
# Host header allowlist, enforced on the dashboard as well as the API routes.
# Only the vhost caddy proxies with needs listing — the healthcheck's loopback
# host:port is seeded in regardless of what this variable holds.
Environment=HOMEPAGE_ALLOWED_HOSTS={{ homepage_domain }}
# Log to stdout only, so nothing is written under the config mount.
Environment=LOG_TARGETS=stdout
# Operator data store: homepage seeds skeleton services/widgets/bookmarks here on
# first boot and the entrypoint chowns it to PUID. A named volume keeps the
# backing store off a host bind mount — podman labels it container_file_t (no :Z)
# and podman_backup captures it automatically.
Volume=homepage-config:/app/config
# Ansible owns the dashboard configs; each mounted read-only as a single file on
# top of the volume so they stay config-as-code without shadowing the seeded data.
{% for config in homepage_configs %}
Volume=/etc/homepage/{{ config }}:/app/config/{{ config }}:ro,Z
{% endfor %}
# Restart backstop against homepage's own health endpoint (busybox wget ships in
# the alpine image), not the monitor — see the health convention in roles/CLAUDE.md.
HealthCmd=wget -q --tries=1 --spider http://127.0.0.1:3000/api/healthcheck
HealthInterval=5m
HealthTimeout=30s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
