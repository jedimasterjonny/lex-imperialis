{#- Widget credentials, one line each under the prefix homepage requires: it
    substitutes {{HOMEPAGE_VAR_<NAME>}} in any config file with the environment
    variable of that name, so a key never lands in the mode-0644 configs.
    dictsort so a re-render is byte-identical and the handler stays quiet. -#}
{% for name, value in homepage_secrets | dictsort %}
HOMEPAGE_VAR_{{ name }}={{ value }}
{% endfor %}
