{% set scheme = '' if wordpress_tls else 'http://' %}
{{ wordpress_domains | map('regex_replace', '^', scheme) | join(', ') }} {
{% if wordpress_origin_pull %}
	# Only Cloudflare's edge holds a certificate signed by this CA, so the origin
	# refuses the handshake to anyone who found its IP — which an origin firewall
	# scoped to Cloudflare's published ranges cannot do, as every Cloudflare
	# account shares them. Caddy also enforces SNI/Host agreement once client auth
	# is configured.
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/cloudflare-origin-pull-ca.pem
		}
	}

{% endif %}
{% if wordpress_tls %}
	# HSTS only applies over HTTPS.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
{% endif %}
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	header Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
	# Don't advertise the PHP version the upstream tacks on.
	header -X-Powered-By

	# readme.html and license.txt just broadcast the exact core version.
	@version_files path /readme.html /license.txt
	respond @version_files 404

	# The installer, the sample config, and files core only ever includes: no
	# legitimate request names them once the site is installed, and executed out
	# of context they fatal — setup-config.php reaching for the object cache at
	# its 127.0.0.1 default on the way. Prefixes, so the /file.php/x PATH_INFO
	# form that mod_php also runs is caught too.
	@internal_files path /wp-config-sample.php* /wp-settings.php* /wp-admin/install.php* /wp-admin/setup-config.php* /wp-admin/includes/* /wp-content/advanced-cache.php* /wp-content/object-cache.php*
	respond @internal_files 404

	# Cache static assets for a year, deferred so it beats any Cache-Control the
	# upstream sets. WordPress ?ver=-busts its css/js and renames re-uploaded
	# media, so nothing served from a static URL goes stale.
{# Extension list duplicated in terraform/edge-emmasedit-com.tf's cache rule. #}
	@static path *.css *.js *.svg *.ico *.gif *.png *.jpg *.jpeg *.webp *.avif *.woff *.woff2 *.ttf *.otf *.eot
	header @static {
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}

	reverse_proxy wordpress:80
}
