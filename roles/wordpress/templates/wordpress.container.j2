[Unit]
Description=WordPress
{# The database unit starts first; wordpress reconnects until it answers. #}
Requires=wordpress-db.service
After=wordpress-db.service
{# The cache is optional — WP_REDIS_GRACEFUL makes the drop-in fall back to the #}
{# in-process cache instead of killing the request — so only order after it, #}
{# never require it. #}
Wants=wordpress-valkey.service
After=wordpress-valkey.service

[Container]
ContainerName=wordpress
Image={{ wordpress_image }}
Network=caddy.network
NoNewPrivileges=true
DropCapability=all
{# The root entrypoint unpacks core into the volume (CHOWN, FOWNER, #}
{# DAC_OVERRIDE), then apache binds :80 (NET_BIND_SERVICE) and drops its #}
{# workers to www-data (SETUID, SETGID). #}
AddCapability=CHOWN DAC_OVERRIDE FOWNER NET_BIND_SERVICE SETGID SETUID
EnvironmentFile=/etc/wordpress/app.env
Volume=wordpress-html:/var/www/html
{# Read-only must-use plugin, mounted as a single file so it never shadows the #}
{# site's own mu-plugins already in the volume. Both file binds are z, not Z: #}
{# the wp wrapper's --volumes-from inherits them, and Z stamps the host file #}
{# with the private MCS pair of whichever container mounted last, so every #}
{# cron run left apache unable to read either file. #}
Volume=/etc/wordpress/mu-plugins/wordpress-hardening.php:/var/www/html/wp-content/mu-plugins/wordpress-hardening.php:ro,z
{# Read-only apache drop-in disabling PHP under wp-content/uploads, so a webshell #}
{# written into that writable tree can't execute. #}
Volume=/etc/wordpress/uploads-no-exec.conf:/etc/apache2/conf-enabled/uploads-no-exec.conf:ro,z
{# DB-independent liveness — a static asset, so a database blip never #}
{# restart-loops apache; HealthOnFailure=kill + Restart=on-failure self-heals. #}
HealthCmd=curl -fsS http://127.0.0.1/wp-includes/images/blank.gif -o /dev/null
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=120s
HealthOnFailure=kill

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
