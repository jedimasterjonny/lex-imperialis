[Unit]
Description=Prune unused podman images

[Service]
Type=oneshot
# Type=oneshot has no start timeout — see restic_backup for the full rationale.
# The consequence particular to a weekly timer: every later trigger merges into
# the run already in flight, so a wedge stops the prune for good.
TimeoutStartSec=15m
ExecStart=/usr/local/sbin/podman-image-prune.sh
