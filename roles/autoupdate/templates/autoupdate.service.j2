# {{ ansible_managed }}
[Unit]
Description=Unattended system update and reboot
Wants=network-online.target
After=network-online.target
# Bounds the Restart= below to the initial run plus three retries. The window is
# a day so a burst spent tonight never refuses next week's timer.
StartLimitIntervalSec=1d
StartLimitBurst=4

[Service]
Type=oneshot
# Defer the update while an Ansible apply is in progress on this host: the dup
# holds the package lock the apply's package tasks need, and the reboot cuts its
# SSH session mid-task. The mirror of arbites's hold, which only covers an update
# already running when an apply is due; the repeat ahead of the reboot below
# catches an apply that hold cannot see — one started by hand against this host,
# one past its fail-open probe, one outlasting this bound. 15m outlasts a whole
# fleet apply with margin, and `-` makes the bound a delay, never a skipped week.
# Both bounds stack on the timer's jitter and still fit MicroOSBuildStale's for:
# (3h). This one recurs on each retry, so a signal stuck through every bound
# carries the retry burst just past AutoupdateFailed's (4h), and an update
# healing on its last retry can page minutes before it clears. Change a bound
# and recheck both.
ExecStartPre=-/usr/bin/timeout 15m /usr/local/sbin/autoupdate-defer.sh
# One ExecStart= per element, which Type=oneshot runs in order and aborts on the
# first failure: apt needs its metadata refreshed before the dist-upgrade, where
# zypper refreshes its own.
{% for command in autoupdate_update_command %}
ExecStart={{ command }}
{% endfor %}
# A changed conffile otherwise prompts and hangs the unit until TimeoutStartSec,
# on a host with nobody at the console. Inert under zypper, so it costs no
# conditional.
Environment=DEBIAN_FRONTEND=noninteractive
# 102/103 are zypper's "reboot/restart recommended" infos on a successful run,
# not failures: accept them so the reboot still fires. A real failure (a lower
# exit code) skips ExecStartPost, leaving the system un-rebooted for inspection.
# transactional-update absorbs both codes and exits 0, and apt uses 0/100, so
# this is inert on either.
SuccessExitStatus=102 103
# A mirror serving repo metadata ahead of the RPMs it indexes aborts the whole
# commit ("Some packages could not be provided"), which on a weekly timer with no
# retry leaves the host unpatched for seven days over a lag that clears in hours.
# Retry hourly so it heals unattended; the last attempt's ExecStopPost is what
# rewrites the metric, so a retry that succeeds also clears AutoupdateFailed.
# Only on-failure: a successful run has already reached ExecStartPost and is
# rebooting. The 3h this spans is what the alert's for: has to outlast.
Restart=on-failure
RestartSec=1h
# Both ahead of the reboot, so the writes do not race shutdown the way
# ExecStopPost's does, and `-`-prefixed because the reboot must not hinge on a
# metric writer: a failed hook leaves the previous publication standing rather
# than stranding the host on the pre-update kernel. Each script's header has what
# it publishes and why. The cleanup is first because it is the one that changes
# the system: the holds hook reads locks, which no removal touches, so it reports
# the same either way and loses nothing by following. MicroOS has no cleanup
# here: its dup lands in a snapshot this boot is not running, so a count taken
# now reads the old one, and autoupdate-cleanup.service takes it after the
# reboot instead.
{% if not autoupdate_transactional | bool %}
ExecStartPost=-/usr/local/sbin/autoupdate-cleanup.sh
{% endif %}
ExecStartPost=-/usr/local/sbin/autoupdate-holds.sh
ExecStartPost=-/usr/bin/timeout 15m /usr/local/sbin/autoupdate-defer.sh
# Reboot here rather than hand the job to rebootmgr on MicroOS: a
# transactional-update asked to reboot exits 0 even when rebootmgrd is down and
# the reboot silently never happens, which the metric below would still record
# as a successful run on a host left on the old snapshot.
ExecStartPost=/usr/bin/systemctl reboot
# Runs whether the update succeeded (then the reboot above) or failed, reading
# $SERVICE_RESULT to record the outcome as a node_exporter metric — a silently
# failing update otherwise leaves the host unpatched with no signal.
ExecStopPost=/usr/local/sbin/autoupdate-metric.sh
