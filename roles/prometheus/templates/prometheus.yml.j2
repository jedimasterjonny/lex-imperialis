# Managed by Ansible (prometheus role).
global:
  scrape_interval: 15s

# Here rather than as --storage.tsdb.retention.time, which the pinned Prometheus
# marks [DEPRECATED] in its own --help and redirects to this field.
storage:
  tsdb:
    retention:
      time: {{ prometheus_retention_time }}
{% if prometheus_out_of_order_time_window %}
    # Without this an agent's replayed backlog is rejected as out of bounds the
    # moment it predates the last block this server compacted — see the default's
    # comment.
    out_of_order_time_window: {{ prometheus_out_of_order_time_window }}
{% endif %}
{% if prometheus_alertmanager_targets %}

alerting:
  alertmanagers:
    - static_configs:
        - targets: {{ prometheus_alertmanager_targets | to_json }}

rule_files:
  - /etc/prometheus/rules/*.yml
{% endif %}

scrape_configs:
  # The only job this server runs. Everything the fleet exports is scraped by the
  # prometheus_agent role elsewhere and pushed in over remote_write, so this
  # discovers no targets of its own — the alerting block above is how it reaches
  # Alertmanager, not a scrape of it. The self-scrape stays because
  # PrometheusRuleEvaluationFailing and PrometheusConfigReloadFailed read it, and
  # nothing off this host reports on the rule evaluator's own health.
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
