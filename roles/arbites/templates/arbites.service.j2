# {{ ansible_managed }}
[Unit]
Description=Apply origin/{{ arbites_branch }} to the fleet
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The GitHub deployment token, kept out of this world-readable unit. Optional (`-`):
# the role always renders it, but a missing file must not wedge the timer — with no
# token both scripts simply skip the deployment record.
EnvironmentFile=-{{ arbites_env_file }}
# Skip the cycle while autoupdate is running: this timer can tick inside
# autoupdate's weekly dup, and the role's zypper query then fails on the lock (rc 7). A
# condition exit of 1 leaves the unit inactive rather than failed, the metric
# hook counts its exec-condition result as success, and the next cycle retries.
# ActiveState, as arbites.sh's fleet hold reads it: a running oneshot is
# activating, which is-active denies.
ExecCondition=/bin/sh -c '! systemctl show --property=ActiveState --value autoupdate.service | grep -qxE "active|activating|reloading|deactivating"'
ExecStart={{ arbites_script }}
# Runs whether ExecStart succeeded or failed, reading $SERVICE_RESULT to record
# the outcome as a node_exporter metric.
ExecStopPost={{ arbites_metric_script }}
