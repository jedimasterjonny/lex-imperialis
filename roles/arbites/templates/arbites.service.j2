# {{ ansible_managed }}
[Unit]
Description=Apply origin/{{ arbites_branch }} to the fleet
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# The GitHub deployment token, kept out of this world-readable unit. Optional (`-`):
# the role always renders it, but a missing file must not wedge the timer — with no
# token both scripts simply skip the deployment record.
EnvironmentFile=-{{ arbites_env_file }}
# Skip the cycle while autoupdate is running: its Friday dup and this timer both
# land at 04:00, and the role's zypper query then fails on the lock (rc 7). A
# condition exit of 1 leaves the unit inactive rather than failed, so the metric
# hook records success and the next cycle retries.
ExecCondition=/bin/sh -c '! systemctl --quiet is-active autoupdate.service'
ExecStart={{ arbites_script }}
# Runs whether ExecStart succeeded or failed, reading $SERVICE_RESULT to record
# the outcome as a node_exporter metric.
ExecStopPost={{ arbites_metric_script }}
