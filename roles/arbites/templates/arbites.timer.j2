# {{ ansible_managed }}
[Unit]
Description=Reconcile the fleet to origin/{{ arbites_branch }}

[Timer]
OnCalendar={{ arbites_oncalendar }}
RandomizedDelaySec={{ arbites_randomized_delay }}
# Persistent (unlike autoupdate): catching up a reconcile missed across a reboot
# is safe and wanted — it only applies main, never reboots.
Persistent=true

[Install]
WantedBy=timers.target
