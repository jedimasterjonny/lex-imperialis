#!/usr/bin/env bash
# {{ ansible_managed }}
# Reconcile the fleet to origin/{{ arbites_branch }}: fetch the branch
# into the service-owned clone and, when it has advanced, apply every host play
# from that tree. Runs unattended on arbites.timer; the ExecStopPost
# hook records the outcome. This is the operator's standing unattended-apply path
# — pause it by touching the pause flag or disabling the timer.
set -euo pipefail

repo="{{ arbites_repo_dir }}"
venv="{{ arbites_venv_dir }}"
branch="{{ arbites_branch }}"
vault_pass="{{ arbites_vault_pass_file }}"
ssh_key="{{ arbites_ssh_key_file }}"
pause_flag="{{ arbites_pause_flag }}"
last_applied="{{ arbites_last_applied_file }}"
github_repo="{{ arbites_github_repo }}"
deployment_env="{{ arbites_deployment_environment }}"
deployment_id_file="{{ arbites_deployment_id_file }}"

# GitHub Deployments API, the same record the terraform workflow gets from its
# `environment:` key. Telemetry only: every call is best-effort, so a GitHub outage
# or an expired token can never fail a fleet apply. Reads the body from stdin so a
# jq-built payload pipes straight in.
github_api() {
    curl --silent --show-error --fail --max-time 15 \
        --header "Authorization: Bearer ${ARBITES_GITHUB_TOKEN:-}" \
        --header "Accept: application/vnd.github+json" \
        --header "X-GitHub-Api-Version: 2022-11-28" \
        --data @- "https://api.github.com/repos/$github_repo/$1"
}

# Pin each fleet host against the operator-seeded known_hosts when on, so a MITM
# presenting a wrong key aborts the connect (the --ssh-extra-args below makes that
# known_hosts authoritative) rather than receiving the host's rendered secrets.
export ANSIBLE_HOST_KEY_CHECKING={{ arbites_host_key_checking | string | lower }}

# Soft pause: a deliberate hold exits success so it never trips the failure
# alert. The timer keeps firing as a no-op until the flag is removed.
if [ -e "$pause_flag" ]; then
    echo "paused: $pause_flag present, skipping reconcile"
    exit 0
fi

# origin/$branch is the only source of truth: fetch just it and discard any drift
# in the clone — never apply a local or feature branch.
git -C "$repo" fetch origin "$branch"
git -C "$repo" reset --hard "origin/$branch"
# reset --hard leaves untracked files, and ansible.cfg reads `inventory` as a
# *directory* — so a file planted under inventory/ is parsed as an inventory source
# on every later reconcile, outliving a revert of the commit that added it. -x so a
# .gitignore match is no hiding place, -ff to recurse into a planted nested clone.
# Nothing the reconciler needs is untracked here: venv, vault pass and key are not.
git -C "$repo" clean -xffd
target="$(git -C "$repo" rev-parse HEAD)"

# Near-free idle run: apply only when the branch has actually advanced.
if [ -f "$last_applied" ] && [ "$(cat "$last_applied")" = "$target" ]; then
    echo "origin/$branch unchanged at ${target:0:12}, nothing to apply"
    exit 0
fi

echo "applying ${target:0:12} to the fleet"

# Open the deployment record this run's outcome will close (the ExecStopPost hook
# posts the final state, reading the id back from this file). Clear any id first: a
# run killed before its hook ran would otherwise hand its stale deployment this
# run's result. No token — molecule, or the operator opting out — skips the record.
rm -f "$deployment_id_file"
deployment_id=""
if [ -n "${ARBITES_GITHUB_TOKEN:-}" ]; then
    # auto_merge and required_contexts must both be turned off explicitly: their
    # defaults make GitHub try to merge the base branch in, then refuse a ref whose
    # checks are not green. Neither means anything for a record of an apply that has
    # already started, and either one silently yields no deployment.
    deployment_id="$(jq -nc \
        --arg ref "$target" --arg env "$deployment_env" \
        '{ref: $ref, environment: $env, auto_merge: false, required_contexts: [],
          description: "arbites fleet reconcile", production_environment: true}' \
        | github_api deployments | jq -r '.id // empty')" || deployment_id=""
    if [ -n "$deployment_id" ]; then
        echo "$deployment_id" >"$deployment_id_file"
        jq -nc '{state: "in_progress", description: "applying to the fleet"}' \
            | github_api "deployments/$deployment_id/statuses" >/dev/null || true
    else
        echo "warning: could not open a GitHub deployment record; applying anyway"
    fi
fi

# Run from the clone root so ansible picks up the repo's ansible.cfg (inventory,
# roles_path), exactly as make apply does.
cd "$repo" || exit 1
# Sync the venv to the just-fetched requirements before applying, so a bumped
# ansible pin is in place up front and the self-apply's own pip task finds it
# already satisfied — it never reinstalls ansible under the running process.
"$venv/bin/pip" install --quiet --requirement requirements.txt
# UserKnownHostsFile makes the seeded known_hosts authoritative; CheckHostIP=no pins
# on the connection name/address alone, so keyscanning each host as ansible reaches
# it (including scholam's own loopback) suffices; empty array when off.
{% if arbites_host_key_checking | bool %}
ssh_extra_args=(--ssh-extra-args "-o UserKnownHostsFile={{ arbites_known_hosts_file }} -o GlobalKnownHostsFile=/dev/null -o CheckHostIP=no")
{% else %}
ssh_extra_args=()
{% endif %}
# --diff lands the change set in the journal; the key reaches each host's account.
# fleet-apply.sh shards site.yml by host so the remote hosts converge at once and
# scholam (self) still goes last, so this run never restarts its own timer. It
# runs ansible off PATH, which is what puts the venv's in front of any system one.
PATH="$venv/bin:$PATH" bin/fleet-apply.sh \
    --private-key "$ssh_key" \
    --vault-password-file "$vault_pass" \
    "${ssh_extra_args[@]}" \
    --diff

# Record the applied SHA only after a clean full apply; a failure leaves the
# previous value so the next run retries the same target.
echo "$target" >"$last_applied"
echo "applied ${target:0:12}"
