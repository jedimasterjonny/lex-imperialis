#!/usr/bin/env bash
# {{ ansible_managed }}
# systemd ExecStopPost hook for arbites.service: record the run's outcome
# as a node_exporter textfile metric so Prometheus alerts when an unattended fleet
# apply fails and main silently stops reaching the fleet. systemd sets
# SERVICE_RESULT to "success" iff ExecStart exited 0.
set -euo pipefail

dir="{{ arbites_textfile_dir }}"
last_applied="{{ arbites_last_applied_file }}"
github_repo="{{ arbites_github_repo }}"
deployment_id_file="{{ arbites_deployment_id_file }}"
success=0
[ "${SERVICE_RESULT:-}" = success ] && success=1

# The revision now live on the fleet; absent until the first successful apply.
sha=unknown
[ -s "$last_applied" ] && sha="$(cut -c1-12 "$last_applied")"

mkdir -p "$dir"
# Publish atomically: write a temp file the exporter's *.prom glob ignores, then
# rename it over the target so no scrape reads a half-written file. 0644 so the
# exporter's unprivileged user can read it.
tmp="$(mktemp "$dir/.arbites.prom.XXXXXX")"
cat >"$tmp" <<EOF
# HELP arbites_success Whether the last fleet reconcile run succeeded (1) or failed (0).
# TYPE arbites_success gauge
arbites_success $success
# HELP arbites_last_run_timestamp_seconds Unix time the last fleet reconcile run finished.
# TYPE arbites_last_run_timestamp_seconds gauge
arbites_last_run_timestamp_seconds $(date +%s)
# HELP arbites_applied_commit The git SHA last successfully applied to the fleet.
# TYPE arbites_applied_commit gauge
arbites_applied_commit{sha="$sha"} 1
EOF
chmod 0644 "$tmp"
mv "$tmp" "$dir/arbites.prom"

# Close the GitHub deployment the reconcile opened, if it opened one — only a run
# that actually applied writes an id here, so a paused or unchanged-HEAD cycle posts
# nothing. Deliberately after the metric: the .prom file is what the ArbitesFailed
# alert reads, and it must never wait on a network call. Best-effort, and the id is
# dropped whatever the post did, so a failed close cannot leak this run's outcome
# onto the next run's record.
if [ -n "${ARBITES_GITHUB_TOKEN:-}" ] && [ -s "$deployment_id_file" ]; then
    state=failure
    [ "$success" = 1 ] && state=success
    jq -nc --arg state "$state" --arg sha "$sha" \
        '{state: $state, description: ("fleet at " + $sha)}' \
        | curl --silent --show-error --fail --max-time 15 \
            --header "Authorization: Bearer ${ARBITES_GITHUB_TOKEN:-}" \
            --header "Accept: application/vnd.github+json" \
            --header "X-GitHub-Api-Version: 2022-11-28" \
            --data @- \
            "https://api.github.com/repos/$github_repo/deployments/$(cat "$deployment_id_file")/statuses" \
            >/dev/null \
        || echo "warning: could not close the GitHub deployment record"
    rm -f "$deployment_id_file"
fi
