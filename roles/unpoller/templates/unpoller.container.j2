[Unit]
Description=UniFi Poller

[Container]
ContainerName=unpoller
Image={{ unpoller_image }}
# Host network so the poller reaches the controller exactly as the host does. The
# bind address comes from the environment file, and is loopback, so only the
# co-located scraper reaches /metrics — never the LAN.
Network=host
NoNewPrivileges=true
DropCapability=all
{# Distroless static image with no USER, so the process runs as root; it opens
   ordinary sockets and needs no capability back. #}
# The controller URL and API key, kept out of this world-readable unit.
EnvironmentFile=/etc/unpoller/env
# Upstream's Dockerfile declares a 30s HEALTHCHECK, but no published image carries
# one: the release is built by goreleaser to OCI media types, and HEALTHCHECK is a
# Docker-only config extension BuildKit drops on that export path, so podman has
# nothing to inherit. Kept as a guard against upstream changing exporter, since an
# inherited check would be an OCI exec every 30s on a Raspberry Pi to assert what
# the co-located Prometheus already reports as up{job="unpoller"} — see the health
# convention in roles/CLAUDE.md. The scrape is the monitor either way, and a wedged
# poller shows up as a stale /metrics, which an exec check would not catch.
HealthCmd=none

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
