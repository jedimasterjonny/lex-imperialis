# {{ ansible_managed }}
# unpoller reads its whole configuration from the environment: golift.io/cnfg maps
# each struct's xml tag to UP_<PATH>, overlaying the example up.conf the image
# ships at /etc/unpoller/up.conf. That shipped file is why the two disables below
# are here rather than left to defaults.
UP_UNIFI_DEFAULT_URL={{ unpoller_url }}
UP_UNIFI_DEFAULT_API_KEY={{ unpoller_api_key }}
UP_UNIFI_DEFAULT_VERIFY_SSL={{ unpoller_verify_ssl | bool | lower }}
UP_PROMETHEUS_HTTP_LISTEN={{ unpoller_listen_address }}
UP_PROMETHEUS_INTERVAL={{ unpoller_interval }}
# The shipped up.conf leaves the InfluxDB output enabled at 127.0.0.1:8086, so
# without this the poller retries a write to nothing on every interval. Prometheus
# is the only output this fleet has.
UP_INFLUXDB_DISABLE=true
# save_speedtest ships true, and it gates its own extra controller API call whose
# result lands in unpoller_speedtest_*, which the scrape job does not keep — 1440
# gateway calls a day for series nothing stores. The per-device speedtest fields
# the USG dashboard graphs come off the device stat instead, so they are
# unaffected by this.
UP_UNIFI_DEFAULT_SAVE_SPEEDTEST=false
