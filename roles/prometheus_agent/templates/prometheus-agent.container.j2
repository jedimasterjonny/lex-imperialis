[Unit]
Description=Prometheus in agent mode

[Container]
ContainerName=prometheus-agent
Image={{ prometheus_agent_image }}
# Host network so the agent resolves and routes to its scrape targets exactly as
# the host does, and reaches the co-located exporters on loopback. The web
# endpoint binds prometheus_agent_listen_address, not every interface.
Network=host
NoNewPrivileges=true
DropCapability=all
{# The image runs non-root as nobody, so it needs no capability back. #}
# The image's default command targets a server-mode config and TSDB path, so it
# is replaced wholesale. --agent is what makes this an agent: without it the
# process starts a full TSDB and silently becomes a second, partial Prometheus.
Exec=--agent \
  --config.file={{ prometheus_agent_config_dir }}/prometheus.yml \
  --storage.agent.path=/data-agent \
  --storage.agent.retention.max-time={{ prometheus_agent_retention_max_time }} \
  --web.listen-address={{ prometheus_agent_listen_address }}
# :Z relabels the mount container_file_t on each start, so it never depends on
# the host's ambient label surviving an SELinux relabel (as /etc/caddy's did not).
Volume={{ prometheus_agent_config_dir }}:{{ prometheus_agent_config_dir }}:ro,Z
# The write-ahead log: the agent's whole buffer against the receiver being
# unreachable, so it is a named volume rather than scratch space. :U hands it to
# the image's nobody user, which rootful podman would otherwise create root-owned.
Volume=prometheus-agent-data:/data-agent:U
# Restart backstop, not the monitor — but unlike a proxied service this binds
# loopback, so no blackbox probe can reach it and this check is the only one.
HealthCmd=wget -q -O /dev/null http://{{ prometheus_agent_listen_address }}/-/healthy
# 5m: an exec healthcheck is a full OCI exec costing whole CPU-seconds on this
# hardware, so it runs at a backstop cadence. It is also what drives
# ServiceRestartStorm's restart rate for this unit — change the cadence and that
# alert's window changes with it.
HealthInterval=5m
HealthTimeout=30s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
