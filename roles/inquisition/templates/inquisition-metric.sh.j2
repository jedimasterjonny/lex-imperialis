#!/usr/bin/env bash
# {{ ansible_managed }}
# systemd ExecStopPost hook for inquisition.service: record the run's outcome as
# a node_exporter textfile metric, separate from the drift payload — a check
# that crashes mid-run must still record its failure, and must not zero the
# offenders it never measured. systemd sets SERVICE_RESULT to "success" iff
# ExecStart exited 0.
set -euo pipefail

dir="{{ inquisition_textfile_dir }}"
success=0
[ "${SERVICE_RESULT:-}" = success ] && success=1

mkdir -p "$dir"
# Publish atomically: write a temp file the exporter's *.prom glob ignores, then
# rename it over the target so no scrape reads a half-written file. 0644 so the
# exporter's unprivileged user can read it.
tmp="$(mktemp "$dir/.inquisition-run.prom.XXXXXX")"
cat >"$tmp" <<EOF
# HELP inquisition_success Whether the last drift check run succeeded (1) or failed (0).
# TYPE inquisition_success gauge
inquisition_success $success
# HELP inquisition_last_run_timestamp_seconds Unix time the last drift check run finished.
# TYPE inquisition_last_run_timestamp_seconds gauge
inquisition_last_run_timestamp_seconds $(date +%s)
EOF
chmod 0644 "$tmp"
mv "$tmp" "$dir/inquisition-run.prom"
