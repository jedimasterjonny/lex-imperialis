# {{ ansible_managed }}
[Unit]
Description=Back up {{ restic_backup_description }} to the astropath NFS share
# Orders after the _netdev NFS mount (which already waits on the network), and
# pulls it in if absent.
RequiresMountsFor={{ restic_backup_root }}
{% if restic_backup_podman_volumes %}
# The timer is Persistent=true, so a host that was off over its window fires a
# catch-up run at boot. Without this the run races the quadlet units' start: the
# quiesce reads the running containers, finds none yet, stops nothing, and they
# then start into a snapshot in progress — a live MariaDB reported as success.
# multi-user.target is the join point because every quadlet unit is Type=notify
# with Before=multi-user.target. Ordering only, so a container that fails to
# start blocks nothing. Full rationale in the role's README.
After=multi-user.target
{% endif %}

[Service]
Type=oneshot
# Type=oneshot disables the start timeout outright — DefaultTimeoutStartSec does
# not apply — so without this the service can sit in activating forever, and in
# podman-volumes mode it does so with the quiesced containers stopped.
TimeoutStartSec={{ restic_backup_timeout_start_sec }}
ExecStart={{ restic_backup_script_dir }}/{{ restic_backup_name }}-backup.sh
# Runs whether ExecStart succeeded or failed, reading $SERVICE_RESULT to record
# the outcome as a node_exporter metric.
ExecStopPost={{ restic_backup_script_dir }}/{{ restic_backup_name }}-backup-metric.sh
