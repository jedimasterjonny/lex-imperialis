#!/usr/bin/env bash
# {{ ansible_managed }}
# Restore this host's podman volumes from a restic snapshot in its per-host
# repository on the astropath NFS share — the inverse of
# {{ restic_backup_name }}-backup.sh, for disaster recovery
# (docs/disaster-recovery.md). Run after the host's play has converged, so the
# volumes exist and are registered.
#
# Takes an optional snapshot ID; default is the latest tagged one. The snapshot
# is restored to a scratch target FIRST and swapped into the live volumes only
# once that has fully succeeded, so a repository that is unreachable, incomplete
# or corrupt costs nothing: the live data is untouched and the containers keep
# running. The units are quiesced only for the swap, and started again only if
# the swap completed. Only volumes this host has are restored, so one the
# snapshot holds and the host does not is named before the confirmation and
# skipped — and with no terminal to name it to, the run stops there instead.
set -euo pipefail

repo="{{ restic_backup_root }}/$(hostname)-{{ restic_backup_name }}-backup"
tag="{{ restic_backup_tag }}"
# An explicit ID overrides the tag filter — restic applies --tag only when
# resolving `latest` — so naming a snapshot restores exactly that one.
snapshot="${1:-latest}"

export RESTIC_REPOSITORY="$repo"
# No $HOME under sudo/ssh, so pin restic's cache where the backup script does.
export RESTIC_CACHE_DIR=/var/cache/restic
# Host-scoped key: this host can open its own repos and no other host's.
export RESTIC_PASSWORD_FILE="{{ restic_backup_password_file }}"
mkdir -p "$RESTIC_CACHE_DIR"

# Defined out here because the body below is raw-fenced: bash's array-length
# expansion opens with a brace-hash pair, which Jinja reads as a comment. Do not
# write that pair literally anywhere outside the fence, including in a comment.
scratch_root="/var/tmp/{{ restic_backup_name }}-restore"

# The astropath NFS mount intermittently serves a spurious ENOENT mid-call, which
# would otherwise abort the one operation that is the last line of defence.
retry() {
    for _ in 1 2 3; do
        if "$@"; then
            return 0
        fi
        sleep 5
    done
    return 1
}
{% raw %}
# Each podman volume's mountpoint — the absolute paths the snapshot stored.
volumes="$(podman volume ls --format '{{ .Mountpoint }}')"
mounts=()
[ -n "$volumes" ] && mapfile -t mounts <<<"$volumes"
if ((${#mounts[@]} == 0)); then
    echo "no podman volumes to restore" >&2
    exit 1
fi

units=()
# none: volumes untouched, safe to restart. partial: mid-swap, so the volumes
# hold a mix of old and restored data and must NOT be served — leave the
# containers down and keep the scratch copy for the operator.
swap=none

cleanup() {
    if [ "$swap" = partial ]; then
        echo "SWAP FAILED PART-WAY: volumes hold a mix of old and restored data." >&2
        echo "Containers left stopped deliberately. Restored copy kept at $scratch" >&2
        return
    fi
    rm -rf "$scratch"
    if ((${#units[@]})); then
        systemctl start "${units[@]}"
    fi
}

# Same filesystem as the volumes on the fleet's single-root hosts, so the swap
# below is a rename rather than a copy; mv falls back to copying if not.
scratch="$(mktemp -d "$scratch_root.XXXXXX")"
trap cleanup EXIT

# Read the whole snapshot before anything live is touched. restic verifies each
# blob against its hash as it writes, so an unreachable, truncated or bit-rotted
# repository fails HERE — with the containers still running on intact data.
retry restic restore --tag "$tag" "$snapshot" --target "$scratch"

# The snapshot stored absolute paths, so each volume reappears under the scratch
# root at its own path. A volume created after the snapshot has no counterpart:
# leave it alone rather than wiping it to nothing.
restorable=()
for mount in "${mounts[@]}"; do
    if [ -d "$scratch$mount" ]; then
        restorable+=("$mount")
    else
        echo "warning: $mount is not in snapshot $snapshot — leaving it untouched" >&2
    fi
done
if ((${#restorable[@]} == 0)); then
    echo "snapshot $snapshot holds none of this host's volumes" >&2
    exit 1
fi

# The swap below wipes and replaces live volumes, so a glob that silently
# matched nothing would do that underneath running containers: refuse instead.
# Ahead of the confirmation because it reads nothing from the repository, so it
# must never be what refuses a run the operator has already agreed to.
shopt -s nullglob
unit_files=(/etc/containers/systemd/*.container)
shopt -u nullglob
if ((${#unit_files[@]} == 0)); then
    echo "no .container quadlets in /etc/containers/systemd — refusing to swap under running containers" >&2
    exit 1
fi

# The other direction, and the one that loses data: a volume the snapshot holds
# that this host does not. Nothing here creates a volume, so it is restored
# nowhere — and a loop driven off the host's volumes alone never looks, so the
# run would exit 0 having dropped it. Every mountpoint is <volume root>/<name>/
# <leaf>, so both the root the snapshot's copy is globbed at and each volume's
# name fall out of the paths already in hand — one source, nothing to disagree.
volume_root="${mounts[0]%/*/*}"
if [ -z "$volume_root" ]; then
    echo "cannot derive the volume root from ${mounts[0]} — refusing to guess what the snapshot holds" >&2
    exit 1
fi
declare -A host_volumes=()
for mount in "${mounts[@]}"; do
    dir="${mount%/*}"
    host_volumes["${dir##*/}"]=1
done
absent=()
shopt -s nullglob
for dir in "$scratch$volume_root"/*/; do
    name="${dir%/}"
    name="${name##*/}"
    [ -n "${host_volumes[$name]:-}" ] || absent+=("$name")
done
shopt -u nullglob

skipped=""
if ((${#absent[@]})); then
    skipped=" ${#absent[@]} snapshot volume(s) will be SKIPPED."
    echo >&2
    echo "!! snapshot $snapshot holds ${#absent[@]} volume(s) this host does not have:" >&2
    printf '!!   %s\n' "${absent[@]}" >&2
    echo "!! Nothing here creates a volume, so they will NOT be restored. To get" >&2
    echo "!! one back, podman volume create it and run this again; if it was" >&2
    echo "!! decommissioned, this is the expected reading." >&2
    echo >&2
fi

# The swap wipes live volume data, so confirm when run interactively. Both
# directions are known by now and nothing live has been touched yet, so this is
# the decision point, and both counts belong in it: the volumes a warning above
# says are staying as they are have scrolled past behind the restore's own
# output, so "n of this host's m" is what makes that shortfall visible.
if [ -t 0 ]; then
    read -r -p "Restore ${#restorable[@]} of this host's ${#mounts[@]} podman volume(s) from $repo@$snapshot?$skipped [y/N] " reply || reply=""
    [ "$reply" = y ] || [ "$reply" = Y ] || { echo "aborted"; exit 1; }
elif ((${#absent[@]})); then
    # Molecule and other non-TTY callers proceed unattended, but not past a
    # snapshot volume with nowhere to go: there is no one reading the warning
    # above at a decision point, and proceeding anyway is what made the loss
    # silent in the first place.
    echo "refusing to restore unattended while the snapshot holds volumes this host does not — create them, or re-run from a terminal to confirm skipping them" >&2
    exit 1
fi

# Quiesce only now: the repository read is done, so nothing below needs the NFS
# share, and the containers were up for all of it.
for unit_file in "${unit_files[@]}"; do
    unit="$(basename "${unit_file%.container}").service"
    if systemctl is-active --quiet "$unit"; then
        units+=("$unit")
    fi
done

if ((${#units[@]})); then
    systemctl stop "${units[@]}"
fi

# Swap: empty each volume and move its restored tree in, so the result is an
# exact mirror rather than an overlay on whatever the play's first container
# start created. Local renames only — restic already preserved ownership and mode.
swap=partial
for mount in "${restorable[@]}"; do
    find "$mount" -mindepth 1 -delete
    find "$scratch$mount" -mindepth 1 -maxdepth 1 -exec mv -t "$mount" -- {} +
done
swap=complete
{% endraw %}
