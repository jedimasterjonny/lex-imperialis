#!/usr/bin/env bash
# {{ ansible_managed }}
# Scheduled restic backup of {{ restic_backup_description }} into a per-host
# repository on the astropath NFS share. restic's retention policy prunes old
# snapshots, and a final restic check verifies repository integrity.
{% if restic_backup_podman_volumes %}
# Podman-volumes mode: the sources are this host's podman volume mountpoints, and
# the containers mounting them are quiesced for a consistent snapshot and always
# restarted (trap on EXIT).
{% endif %}
set -euo pipefail

repo="{{ restic_backup_root }}/$(hostname)-{{ restic_backup_name }}-backup"
keep_weekly="{{ restic_backup_keep_weekly }}"
keep_monthly="{{ restic_backup_keep_monthly }}"
tag="{{ restic_backup_tag }}"

export RESTIC_REPOSITORY="$repo"
# systemd runs this with no $HOME, so pin restic's cache somewhere it can find it.
export RESTIC_CACHE_DIR=/var/cache/restic
# Host-scoped key: this host can open its own repos and no other host's.
export RESTIC_PASSWORD_FILE="{{ restic_backup_password_file }}"

# The astropath NFS mount intermittently serves a spurious ENOENT for a file that
# exists — a lock, or the repo config — aborting a restic call mid-run. Retry each
# call a few times to ride out the blip rather than fail the whole backup.
retry() {
    for _ in 1 2 3; do
        if "$@"; then
            return 0
        fi
        sleep 5
    done
    return 1
}

# The share is _netdev, and stopping the last podman bridge fires an NM event
# that unmounts it mid-run (roles/podman/tasks/main.yml). Unmounted, the
# mountpoint directory is still there on the root fs: mkdir -p would create a
# shadow repo inside it, restic init it, back up into it, and exit 0 with
# success 1 — the real repo silently stops receiving snapshots and no alert ever
# fires. Assert immediately before each write rather than once at the top, since
# the quiesce that triggers the unmount runs in between.
require_mounted() {
    if ! mountpoint -q {{ restic_backup_root | quote }}; then
        echo "{{ restic_backup_root }} is not mounted — refusing to write a shadow repo" >&2
        exit 1
    fi
}

{% if restic_backup_check_read_data_weeks | int > 0 %}
# Re-hash one deterministic 1/N slice of data packs during the integrity check to
# catch bit-rot the metadata check misses; the n/t slice rotates by ISO week and
# is stable across retry() — see restic_backup_check_read_data_weeks. 10# so a
# zero-padded week parses as decimal not octal; | int so an empty or "0" opt-out
# is falsy here rather than a rendered div-by-zero. Empty or 0 reverts to a
# structural check only.
check_args=(--read-data-subset="$(( 10#$(date +%V) % {{ restic_backup_check_read_data_weeks | int }} + 1 ))/{{ restic_backup_check_read_data_weeks | int }}")
{% else %}
check_args=()
{% endif %}

{% if restic_backup_podman_volumes %}
# Volumes left out of the snapshot, whose containers stay up through the run —
# see restic_backup_podman_volume_excludes.
declare -A excluded=()
{% for name in restic_backup_podman_volume_excludes %}
excluded[{{ name | quote }}]=1
{% endfor %}
# raw-fenced from here: the Go-template formats and bash array-length expansions
# would otherwise read to Jinja as tags.
{% raw %}
# An exclusion naming no volume on this host — renamed under it, or a typo —
# would silently return that volume to the snapshot and its container to the
# quiesce, reporting success. Refuse instead, before anything is stopped.
for name in "${!excluded[@]}"; do
    if ! podman volume exists "$name"; then
        echo "excluded volume $name does not exist on this host — refusing to guess what was meant" >&2
        exit 1
    fi
done
# Each podman volume's mountpoint, less the excluded names. Capturing into a
# variable (rather than a process substitution, which would mask a failure) lets
# set -e abort here if podman errors, instead of silently reporting an empty,
# successful backup.
volumes="$(podman volume ls --format '{{ .Name }} {{ .Mountpoint }}')"
sources=()
while read -r name mountpoint; do
    if [ -n "$name" ] && [ -z "${excluded[$name]+x}" ]; then
        sources+=("$mountpoint")
    fi
done <<<"$volumes"
{% endraw %}
{% else %}
# The configured paths to snapshot.
sources=(
{% for path in restic_backup_paths %}
    {{ path | quote }}
{% endfor %}
)
{% endif %}
{% raw %}
if ((${#sources[@]} == 0)); then
    echo "no sources to back up"
    exit 0
fi
{% endraw %}

{% if restic_backup_podman_volumes %}
# Quiesce the running containers for a consistent snapshot, and restart them
# however the backup exits.
{% raw %}
# Two calls, and a container exiting between them — a Restart= loop, a stop in
# flight — fails the second. Not retry(): that captures every attempt's output,
# so a partial listing from the failed attempt would ride in beside the good
# one. Three attempts, a millisecond race, no sleep; all three failing is a
# podman that cannot be trusted to quiesce.
running_containers() {
    podman ps -q | xargs -r podman inspect --format '{{ index .Config.Labels "PODMAN_SYSTEMD_UNIT" }}:{{ range .Mounts }}{{ if eq .Type "volume" }} {{ .Name }}{{ end }}{{ end }}'
}
listed=false
for _ in 1 2 3; do
    if containers="$(running_containers)"; then
        listed=true
        break
    fi
done
if [ "$listed" = false ]; then
    echo "could not list the running containers — refusing to snapshot un-quiesced" >&2
    exit 1
fi

# Stop what mounts a volume in the snapshot. The README has the rule.
units=()
while IFS=: read -r unit mountlist; do
    read -r -a mounts <<<"$mountlist"
    for name in "${mounts[@]}"; do
        if [ -n "${excluded[$name]+x}" ]; then
            continue
        fi
        if [ -z "$unit" ]; then
            echo "warning: a container no unit owns mounts $name — snapshotting it live" >&2
        elif systemctl is-active --quiet "$unit"; then
            # Not one mid-stop: its container is still listed, but restarting
            # it would undo the stop in flight.
            units+=("$unit")
        fi
        break
    done
done <<<"$containers"

# No || true: a unit that fails to restart fails the service, so it surfaces
# rather than leaving a container down silently.
restart_units() {
    if ((${#units[@]})); then
        systemctl start "${units[@]}"
    fi
}
trap restart_units EXIT

if ((${#units[@]})); then
    systemctl stop "${units[@]}"
fi
{% endraw %}
{% endif %}

{% if restic_backup_excludes %}
# Drop re-acquirable churn (caches, virtualenvs, node_modules) so it neither
# bloats the repo nor the weekly integrity re-read. A slash-free pattern matches
# that basename at any depth under the sources.
exclude_args=(
{% for pattern in restic_backup_excludes %}
    --exclude={{ pattern | quote }}
{% endfor %}
)
{% else %}
exclude_args=()
{% endif %}

require_mounted
mkdir -p "$repo" "$RESTIC_CACHE_DIR"
retry restic snapshots >/dev/null 2>&1 || retry restic init
# Drop locks orphaned by a killed restic — an interrupted ad-hoc `restic ls`
# against the repo leaves one, and restic does not skip a dead process's lock
# when taking its own. The exclusive `forget --prune` below is refused, failing
# the run every week until the lock is cleared by hand, with the snapshot itself
# already saved. unlock removes only stale locks — one whose owner is still alive
# survives, so a concurrent run is unaffected. --retry-lock is no use: it
# re-checks the same lock and refuses just the same.
retry restic unlock
require_mounted
retry restic backup --tag "$tag" "${exclude_args[@]}" "${sources[@]}"
# Group by host,tags rather than restic's default host,paths. In podman-volumes
# mode the paths are the volume mountpoints, so adding or removing a container
# opens a fresh retention group and freezes the old one: its snapshots become that
# group's newest weeklies and never age out, growing the repo — and the off-site
# mirror — without bound. The tag is fixed per consumer role where the source set
# is not, so grouping on it keeps one retention lineage per repository.
retry restic forget --tag "$tag" --group-by host,tags \
    --keep-weekly "$keep_weekly" --keep-monthly "$keep_monthly" --prune

{% if restic_backup_podman_volumes %}
# Bring the quiesced containers back up before verifying the repository: the
# check only reads the repo, so running it post-restart holds downtime to the
# backup window. The EXIT trap's restart is then a no-op (systemctl start is
# idempotent).
restart_units
{% endif %}

# Verify repository integrity so silent structural corruption on the NFS store
# fails the service instead of lying dormant until a restore.
retry restic check "${check_args[@]}"
