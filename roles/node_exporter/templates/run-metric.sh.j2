#!/usr/bin/env bash
# {{ ansible_managed }}
# Shared systemd ExecStopPost hook: records a scheduled unit's outcome as a
# node_exporter textfile metric, so a run that fails — or a timer that stops
# firing — alerts instead of failing silently. systemd sets SERVICE_RESULT to
# "success" iff ExecStart exited 0.
#
# node_exporter owns this because it owns the textfile collector directory. A
# consuming role symlinks it into its own templates/ under the name it installs,
# and supplies the four run_metric_* vars on the template task. A unit needing
# more than the two metrics below keeps its own script (arbites, which also
# publishes the applied commit).
set -euo pipefail

dir="{{ run_metric_textfile_dir }}"
success=0
[ "${SERVICE_RESULT:-}" = success ] && success=1

mkdir -p "$dir"
# Publish atomically: write a temp file the exporter's *.prom glob ignores, then
# rename it over the target so no scrape reads a half-written file. 0644 so the
# exporter's unprivileged user can read it.
tmp="$(mktemp "$dir/.{{ run_metric_file }}.prom.XXXXXX")"
cat >"$tmp" <<EOF
# HELP {{ run_metric_name }}_success Whether the last {{ run_metric_description }} run succeeded (1) or failed (0).
# TYPE {{ run_metric_name }}_success gauge
{{ run_metric_name }}_success $success
# HELP {{ run_metric_name }}_last_run_timestamp_seconds Unix time the last {{ run_metric_description }} run finished.
# TYPE {{ run_metric_name }}_last_run_timestamp_seconds gauge
{{ run_metric_name }}_last_run_timestamp_seconds $(date +%s)
EOF
chmod 0644 "$tmp"
mv "$tmp" "$dir/{{ run_metric_file }}.prom"
# Force to disk before returning. This file is not a convenience copy of what
# systemd knows: autoupdate's successful run reboots the host from its own
# ExecStartPost and its timer is Persistent=no, so LastTriggerUSec does not
# survive that reboot — measured across the fleet, every host's last recorded
# autoupdate run predates its own boot while systemd reports the timer as never
# triggered. A dropped write would stall the timestamp into a false *Overdue on a
# healthy host. Unconditional rather than a per-caller flag: one sync per timer
# fire costs nothing the kernel's own writeback does not already do.
sync
