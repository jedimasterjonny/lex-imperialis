# {{ ansible_managed }}
[Unit]
Description=R2 off-site copy metrics
# The timer is Persistent=true, so a host back from a reboot that missed a tick
# fires this at boot — ahead of NetworkManager without the ordering, where the
# endpoint does not resolve and the catch-up run records a failure instead of a
# reading.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Type=oneshot does not inherit DefaultTimeoutStartSec. Every request the probe
# makes carries its own socket timeout, but a listing that keeps paginating
# would not: this bounds the run as a whole so a stuck probe cannot park the unit
# in activating forever, where the timer cannot start another and the stale
# payload keeps being republished as though it were fresh.
TimeoutStartSec=5min
EnvironmentFile={{ r2_mirror_env_file }}
ExecStart={{ r2_mirror_script }}
# Runs whether ExecStart succeeded or failed, reading $SERVICE_RESULT to record
# the outcome as a node_exporter metric.
ExecStopPost={{ r2_mirror_metric_script }}
