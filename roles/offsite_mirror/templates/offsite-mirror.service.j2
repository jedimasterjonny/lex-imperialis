# {{ ansible_managed }}
[Unit]
Description=Off-site mirror coverage metrics
# The timer is Persistent=true, so a host back from a reboot that missed a tick
# fires this at boot — ahead of NetworkManager without the ordering, where the NAS
# does not resolve and the catch-up run records a failure instead of a reading.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Type=oneshot does not inherit DefaultTimeoutStartSec, and ssh's ConnectTimeout
# bounds only the handshake — a connection that stalls after it would park the
# unit in activating forever: the timer cannot start another run, ExecStopPost
# never fires, and the stale payload keeps being republished as though it were
# fresh. A healthy probe is one connection and three small queries.
TimeoutStartSec=5min
ExecStart={{ offsite_mirror_script }}
# Runs whether ExecStart succeeded or failed, reading $SERVICE_RESULT to record
# the outcome as a node_exporter metric.
ExecStopPost={{ offsite_mirror_metric_script }}
