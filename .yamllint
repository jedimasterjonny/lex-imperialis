---
# Mirrors ansible-lint's bundled yamllint config so standalone yamllint agrees
# with ansible-lint's internal checks. Keep in sync with the pinned ansible-lint.
extends: default

# Skip the venv and other artefacts; ansible-lint is already git-aware.
ignore-from-file: .gitignore

rules:
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
    # cloud-init detects a seed's format by matching `#cloud-config` against the
    # first line literally, so bootstrap/auspex-user-data.yaml cannot carry the
    # space this rule wants. Scoped to the rule, not the file: indentation,
    # duplicate keys and the rest still apply there, and a seed that silently
    # loses an account is exactly what they catch.
    ignore: bootstrap/auspex-user-data.yaml
  comments-indentation: false
  document-start: disable
  line-length:
    max: 160
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
