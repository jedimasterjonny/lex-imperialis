---
profile: production

# The whole-file vault is one encrypted blob — nothing lintable either way.
# Excluding it silences ansible-lint's (non-fatal) decryption warnings, since it
# has no vault password by default or in CI.
exclude_paths:
  - inventory/group_vars/all/vault.yml
  # A cloud-init seed, not Ansible content. ansible-lint's bundled yamllint has
  # no per-rule ignore, so it would fail on the `#cloud-config` first line the
  # format detection requires; the standalone yamllint still lints the file under
  # every other rule.
  - bootstrap/auspex-user-data.yaml

# A .yml under a molecule scenario is inferred as a playbook, so a scenario's
# fixtures file fails syntax-check as "not a list of plays". Declare its kind.
kinds:
  - vars: "**/molecule/*/fixtures.yml"

# Opt-in rules the production profile leaves off but that apply cleanly here.
# The three omitted don't fit this layout: only-builtins would reject the
# containers.podman / community.general / ansible.posix modules the fleet runs
# on, while role-argument-spec and galaxy-version-incorrect want argument-spec
# and collection metadata these loose roles don't carry.
enable_list:
  - empty-string-compare
  - jinja-template-extension
  - no-log-password
  - no-prompting
  - no-same-owner
