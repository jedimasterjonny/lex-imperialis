# Butane source for rogue-trader's Ignition config, to be delivered as Hetzner
# user_data at server creation:
#
#   butane --strict bootstrap/rogue-trader.bu > rogue-trader.ign
#
# bootstrap/rogue-trader.yml renders it through Ansible's template lookup and
# pipes the result into butane at provision time, passing the compiled Ignition
# as user_data; that output stays uncommitted so there is one source of truth.
# The one templated value is the hostname, which is what lets the same document
# serve a spike. `butane --strict --check` still gates this file — the
# placeholder is just a string to butane — and the provision-time compile
# validates the document that actually ships.
#
# Scope is bootstrap/host.sh's, plus the hostname below: the ansible account,
# its key, NOPASSWD sudo and sshd. The owner account, packages, dotfiles and
# every service belong to the roles in playbooks/rogue-trader.yml, which take
# over the moment this lets them in.
#
# Ignition cannot install packages, so this alone does not make the box
# manageable -- the Python interpreter has to be baked into the image already.
# See packer/README.md.
#
# fcos 1.6.0 emits spec 3.5.0, exactly what openSUSE's pristine Ignition 2.26.0
# speaks. Only spec-generic fields are used, so the output is portable.
variant: fcos
version: 1.6.0

passwd:
  users:
    # The account the plays connect as. A system account with no password set,
    # so it is key-only, matching bootstrap/host.sh's useradd --system.
    - name: ansible
      system: true
      home_dir: /home/ansible
      shell: /bin/bash
      # Inlined rather than fetched from GitHub the way host.sh does: a failed
      # fetch in the initrd leaves a box nobody can log into. The cost is that a
      # key rotation needs a commit here too.
      #
      # This write is why packer's stage 2 puts x-initrd.mount on /home: Ignition
      # runs in the initrd, which mounts only /etc, /root and /var by default,
      # and the snapshot holding /home there is read-only. Without that image
      # change the key write fails and takes the whole config with it.
      #
      # common_ansible_authorized_keys from
      # inventory/group_vars/all/authorized_keys.yml. The reconciler's key is
      # here too: without it a rebuilt VPS is reachable by an operator apply but
      # not by the timer, so it would sit unreconciled until someone noticed.
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDHpcn9yrjN0+bAFrmfGo7X4qMdklxvJ3bqdSiyJf5ju jonny@scholam
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDzG7xvJdEAAFfdkOLh1JQT4tRTV3VgUOpoYJqjTl9qk arbites@scholam

storage:
  files:
    # roles/common sets the hostname too, from common_hostname, and that is what
    # the box carries from the converge onwards -- including when the backup
    # scripts read `hostname` to derive their repo names, which happens on a
    # timer long afterwards. This is only the name first boot runs under, so its
    # journal and logs are attributable before Ansible arrives.
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: "{{ rogue_trader_name }}"

    # NOPASSWD so plays escalate unattended. host.sh runs visudo -cf before
    # installing this; Ignition has no validate hook, so the content is kept to
    # the single line host.sh writes and nothing more.
    - path: /etc/sudoers.d/ansible
      mode: 0440
      overwrite: true
      contents:
        inline: |
          ansible ALL=(ALL:ALL) NOPASSWD: ALL

systemd:
  units:
    # MicroOS's presets may already enable this; stating it makes the box's
    # reachability a property of this file rather than of a preset that can
    # change under a rolling distro.
    - name: sshd.service
      enabled: true
